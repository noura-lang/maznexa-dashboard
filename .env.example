# Google Sheets API Key
# Steps to get this:
# 1. Go to https://console.cloud.google.com
# 2. Create a new project (or select existing)
# 3. Enable "Google Sheets API"
# 4. Go to Credentials → Create Credentials → API Key
# 5. Restrict the key: API restrictions → Google Sheets API
# 6. Copy the key below
VITE_GOOGLE_API_KEY=YOUR_API_KEY_HERE

# Sheet IDs (already filled — do not change unless sheets move)
VITE_MAIN_SHEET_ID=1JpgRXx1PFe-_t4LvnAmJ3XkIM_rrFAYJDPTYv-upSDo
VITE_TASKS_SHEET_ID=1FJk53DZqI9gp2qdcJnvY3qH0f3MduzrgoKWlx-4m4Mk

# Tasks sheet tab name — open the Tasks sheet and copy the tab name exactly
VITE_TASKS_SHEET_TAB=Raw Tasks

# Auto-refresh interval in milliseconds (default: 2 hours = 7200000)
VITE_REFRESH_INTERVAL=7200000

# --- Server-side only (no VITE_ prefix — never exposed to the browser) ---
# Google Cloud Service Account used by the /api/am-data and /api/cost-data
# serverless routes (api/*.js, lib/*.js) to read the AM Targets and Employee
# Cost sheets — these two sheets are intentionally NOT shared with
# individual employees' Google accounts; only this service account has
# Viewer access. Same credentials also verify Firebase ID tokens server-side
# (see lib/firebaseAdmin.js).
# GOOGLE_SERVICE_ACCOUNT_EMAIL=maznexa-sheets-reader@your-project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
